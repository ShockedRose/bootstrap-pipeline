{
  "name": "bootstrap-pipeline",
  "version": "0.1.0",
  "scripts": {
    "build": "tsc",
    "watch": "tsc -w",
    "test": "jest",
    "cdk": "cdk",
    "cdk:bootstrap": "cdk bootstrap --context env=prod",
    "cdk:deploy-prod": "cdk deploy --context env=prod --require-approval never",
    "store-secret": "aws secretsmanager create-secret --name github-token --secret-string",
    "delete-secret": "aws secretsmanager delete-secret --secret-id github-token --force-delete-without-recovery"
  },
  "devDependencies": {
    "@types/jest": "^30",
    "@types/node": "^24.10.1",
    "jest": "^30",
    "ts-jest": "^29",
    "aws-cdk": "2.1122.0",
    "ts-node": "^10.9.2",
    "typescript": "~5.9.3"
  },
  "dependencies": {
    "aws-cdk-lib": "^2.254.0",
    "constructs": "^10.5.0"
  }
}
